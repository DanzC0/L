            if type(v) == "table" and v._r then
                if _char(66) ~= "B" or type("") ~= "string" then
                    p_key = (p_key + 23) % 256
                end
                return _DEC_FAM[v._f](v._r, v._s, p_key)
            end
            return v
        end

        local function get_rk(v)
            if v >= 256 then
                return get_k(v - 256)
            else
                return R[R_idx(v)]
            end
        end

        -- Polymorphic Return State Token
        local state = { pc = code_start, tk = 0, res = {} }
        local top_reg = 0

        local function skip_ins()
            local raw_o = _byte(payload, state.pc)
            local rel_p = state.pc - code_start
            local m = get_mask(rel_p, p_seed)
            local o = _bxor(raw_o, m)
            local f = _F[o]
            if f == 0 then state.pc = state.pc + 1
            elseif f == 1 then state.pc = state.pc + 3
            elseif f <= 4 then state.pc = state.pc + 5
            else state.pc = state.pc + 7 end
        end

        -- Clustered Micro-Op Kernels with Decoy Branches (P1)
        local function k_mem(micro, a, b, c_val, sbx)
            if micro == 158 then
                R[R_idx(a)] = R[R_idx(b)]
            elseif micro == 89 then
                for i = 0, b - 1 do R[R_idx(a + i)] = nil end
            elseif micro == 160 then
                R[R_idx(a)] = (b ~= 0)
                if c_val ~= 0 then skip_ins() end
            elseif micro == 145 then
                R[R_idx(a)] = get_k(b)
            elseif micro == 72 then
                R[R_idx(a)] = G[get_k(b)]
            elseif micro == 117 then
                G[get_k(b)] = R[R_idx(a)]
            elseif micro == 87 then
                R[R_idx(a)] = R[R_idx(b)][get_rk(c_val)]
            elseif micro == 123 then
                R[R_idx(a)][get_rk(b)] = get_rk(c_val)
            elseif micro == 37 then
                R[R_idx(a)] = {}
            elseif micro == 203 then
                R[R_idx(a)] = { [get_rk(b)] = get_rk(c_val) }
            end
        end

        local function k_alu(micro, a, b, c_val, sbx)
            local vb = get_rk(b)
            if micro == 77 then
                R[R_idx(a)] = vb + get_rk(c_val)
            elseif micro == 212 then
                R[R_idx(a)] = vb - get_rk(c_val)
            elseif micro == 50 then
                R[R_idx(a)] = vb * get_rk(c_val)
            elseif micro == 106 then
                R[R_idx(a)] = vb / get_rk(c_val)
            elseif micro == 248 then
                R[R_idx(a)] = vb % get_rk(c_val)
            elseif micro == 138 then
                R[R_idx(a)] = vb ^ get_rk(c_val)
            elseif micro == 83 then
                R[R_idx(a)] = tostring(vb) .. tostring(get_rk(c_val))
            elseif micro == 222 then
                R[R_idx(a)] = -vb
            elseif micro == 26 then
                R[R_idx(a)] = not vb
            elseif micro == 58 then
                R[R_idx(a)] = #vb
            elseif micro == 18 then
                R[R_idx(a)] = (vb * 3 + 7) % 65536
            end
        end

        local function k_branch(micro, a, b, c_val, sbx)
            if micro == 49 then
                state.pc = state.pc + sbx
            elseif micro == 194 then
                if (get_rk(b) == get_rk(c_val)) == (a ~= 0) then skip_ins() end
            elseif micro == 210 then
                if (get_rk(b) < get_rk(c_val)) == (a ~= 0) then skip_ins() end
            elseif micro == 248 then
                if (get_rk(b) <= get_rk(c_val)) == (a ~= 0) then skip_ins() end
            elseif micro == 103 then
                if (not R[R_idx(a)]) == (c_val ~= 0) then skip_ins() end
            elseif micro == 35 then
                if (not R[R_idx(b)]) == (c_val ~= 0) then
                    skip_ins()
                else
                    R[R_idx(a)] = R[R_idx(b)]
                end
            elseif micro == 137 then
                local ra = R_idx(a)
                R[ra] = R[ra] - R[R_idx(a + 2)]
                state.pc = state.pc + sbx
            elseif micro == 117 then
                local ra = R_idx(a)
                local step = R[R_idx(a + 2)]
                local idx = R[ra] + step
                R[ra] = idx
                local limit = R[R_idx(a + 1)]
                if (step > 0 and idx <= limit) or (step <= 0 and idx >= limit) then
                    state.pc = state.pc + sbx
                    R[R_idx(a + 3)] = idx
                end
            elseif micro == 31 then
                local cb = R[R_idx(a)]
                local rets = { cb(R[R_idx(a + 1)], R[R_idx(a + 2)]) }
                for i = 1, c_val do R[R_idx(a + 2 + i)] = rets[i] end
                if R[R_idx(a + 3)] ~= nil then
                    R[R_idx(a + 2)] = R[R_idx(a + 3)]
                else
                    skip_ins()
                end
            elseif micro == 208 then
                if a == 0 then state.pc = state.pc end
            end
        end

        local function k_call(micro, a, b, c_val, sbx)
            if micro == 121 then
                -- Distributed Check C (Call Boundary)
                if type(debug) == "table" and debug.gethook and debug.gethook() then
                    top_reg = top_reg + 7
                end
                local args = {}
                local n_args = (b == 0) and _max(0, top_reg - a) or (b - 1)
                for i = 1, n_args do args[i] = R[R_idx(a + i)] end
                local fn = R[R_idx(a)]
                local rets = { fn(_unpack(args, 1, n_args)) }
                if c_val == 0 then
                    top_reg = a + #rets - 1
                    for i = 1, #rets do R[R_idx(a + i - 1)] = rets[i] end
                else
                    top_reg = a + c_val - 2
                    for i = 1, c_val - 1 do R[R_idx(a + i - 1)] = rets[i] end
                end
            elseif micro == 214 then
                local rets = {}
                local count = (b == 0) and _max(0, top_reg - a + 1) or (b - 1)
                for i = 1, count do rets[i] = R[R_idx(a + i - 1)] end
                state.tk = 780740785
                state.res = rets
            elseif micro == 62 then
                for i = 1, b - 1 do R[R_idx(a + i - 1)] = varargs[i] end
            elseif micro == 161 then
                top_reg = top_reg
            end
        end

        local function k_closure(micro, a, b, c_val, sbx)
            if micro == 15 then
                local sub = ps[b]
                local child_uvs = {}
                if sub.num_uvs then
                    for u_idx = 0, sub.num_uvs - 1 do
                        local desc = sub.uvs[u_idx]
                        if desc.in_stack then
                            child_uvs[u_idx] = { R, R_idx(desc.index) }
                        else
                            child_uvs[u_idx] = uv[desc.index]
                        end
                    end
                end
                R[R_idx(a)] = function(...)
                    return run_vm(sub, G, child_uvs, ...)
                end
            elseif micro == 191 then
                local u = uv[b]
                if u then R[R_idx(a)] = u[1][u[2]] end
            elseif micro == 171 then
                local u = uv[b]
                if u then u[1][u[2]] = R[R_idx(a)] end
            elseif micro == 43 then
                local _ = uv[b]
            end
        end

        local _K = {
            [3] = k_mem,
            [5] = k_alu,
            [2] = k_branch,
            [1] = k_call,
            [4] = k_closure,
        }

        while state.pc < code_end and state.tk ~= 780740785 do
            local cur_pc = state.pc
            local raw_op = _byte(payload, cur_pc)
            local rel_pc = cur_pc - code_start
            local roll = get_mask(rel_pc, p_seed)
            local op = _bxor(raw_op, roll)
            local f = _F[op]

            local a, b, c_val, sbx = 0, 0, 0, 0
            if f == 0 then
                state.pc = cur_pc + 1
            elseif f == 1 then
                local b1, b2 = _byte(payload, cur_pc + 1, cur_pc + 2)
                local u1 = b1 + b2 * 256
                a = _bxor(u1, 5)
                state.pc = cur_pc + 3
            elseif f == 2 then
                local b1, b2, b3, b4 = _byte(payload, cur_pc + 1, cur_pc + 4)
                local u1 = b1 + b2 * 256
                local u2 = b3 + b4 * 256
                a = _bxor(u1, 5)
                b = _bxor(u2, 279)
                state.pc = cur_pc + 5
            elseif f == 3 then
                local b1, b2, b3, b4 = _byte(payload, cur_pc + 1, cur_pc + 4)
                local u1 = b1 + b2 * 256
                local u2 = b3 + b4 * 256
                a = _bxor(u1, 5)
                c_val = _bxor(u2, 283)
                state.pc = cur_pc + 5
            elseif f == 4 then
                local b1, b2, b3, b4 = _byte(payload, cur_pc + 1, cur_pc + 4)
                local u1 = b1 + b2 * 256
                local u2 = b3 + b4 * 256
                a = _bxor(u1, 5)
                b = _bxor(u2, 279)
                state.pc = cur_pc + 5
            elseif f == 5 then
                local b1, b2, b3, b4, b5, b6 = _byte(payload, cur_pc + 1, cur_pc + 6)
                local u1 = b1 + b2 * 256
                local u = b3 + b4 * 256 + b5 * 65536 + b6 * 16777216
                if u >= 2147483648 then u = u - 4294967296 end
                a = _bxor(u1, 5)
                sbx = u
                state.pc = cur_pc + 7
            elseif f == 6 then
                local b1, b2, b3, b4, b5, b6 = _byte(payload, cur_pc + 1, cur_pc + 6)
                local u1 = b1 + b2 * 256
                local u2 = b3 + b4 * 256
                local u3 = b5 + b6 * 256
                a = _bxor(u1, 5)
                b = _bxor(u3, 279)
                c_val = _bxor(u2, 283)
                state.pc = cur_pc + 7
            end

            local disp = _D[op]
            if disp then
                local cluster = _floor(disp / 256)
                local micro = disp % 256
                _K[cluster](micro, a, b, c_val, sbx)
            else
                error("[GNC-LVM] Corrupt opcode instruction", 0)
            end
        end

        return _unpack(state.res)
    end

    return run_vm(root_proto, _G, {}, ...)
end

return _GNC_RUN(...)
